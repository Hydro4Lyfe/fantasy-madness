{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install && npm run db:migrate:dev && npm -w @fantasy-madness/db run build && npm -w @fantasy-madness/ingest run build",
    "ingest:run": "npm -w @fantasy-madness/ingest run start",
    "db:generate": "npx prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "prisma": "^6.0.0"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "pg-boss": "^12.5.4"
  }
}
