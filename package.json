{
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "db:generate": "npx prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
