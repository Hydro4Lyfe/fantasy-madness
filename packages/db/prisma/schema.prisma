generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/// Sync lifecycle for the tournament ingestion.
enum TournamentSyncState {
  DISCOVERED
  MONITORING
  BRACKET_LOCKED
  LIVE
  COMPLETED
}

enum GlobalContestStatus {
  OPEN
  LOCKED
  COMPLETE
}

enum DraftStatus {
  OPEN
  DRAFTING
  LOCKED
  COMPLETE
}

enum DraftType {
  SNAKE
  LINEAR
  AUCTION
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum SyncFeedType {
  TOURNAMENT_LIST
  TOURNAMENT_SUMMARY
  TOURNAMENT_SCHEDULE
  GAME_SUMMARY
  DAILY_CHANGE_LOG
}

model Tournament {
  id               String   @id @db.Text @map("tournament_id")
  seasonYear       Int      @map("season_year")
  name             String   @db.Text @map("name")
  startDate        DateTime? @db.Date @map("start_date")
  endDate          DateTime? @db.Date @map("end_date")

  syncState        TournamentSyncState @default(DISCOVERED) @map("sync_state")

  /// Used as the one-way latch for BracketSlot materialization (created once).
  bracketLockedAt  DateTime? @db.Timestamptz(6) @map("bracket_locked_at")

  /// Used as a simple cursor in our MVP+ daily change-log polling.
  nextCheckAt      DateTime? @db.Timestamptz(6) @map("next_check_at")

  eventStatusRaw   Json? @db.JsonB @map("event_status_raw")
  payloadRaw       Json? @db.JsonB @map("payload_raw")

  maxPoints        Int? @map("max_points")
  highScoreDraft   Int? @map("high_score_draft")
  highScoreGlobal  Int? @map("high_score_global")
  statsUpdatedAt   DateTime? @db.Timestamptz(6) @map("stats_updated_at")

  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  teams            TournamentTeam[]
  games            Game[]
  teamStats        TeamTournamentStats[]

  /// NEW: canonical pick surface (64 slots)
  bracketSlots     BracketSlot[]

  globalContests   GlobalContest[]
  drafts           Draft[]

  syncLogs         SyncLog[]

  @@map("tournaments")
  @@index([seasonYear], map: "ix_tournaments_season_year")
  @@index([syncState, nextCheckAt], map: "ix_tournaments_state_nextcheck")
  @@index([startDate], map: "ix_tournaments_start_date")
  @@index([highScoreDraft], map: "ix_tournaments_high_score_draft")
  @@index([highScoreGlobal], map: "ix_tournaments_high_score_global")
}

model Team {
  id          String  @id @db.Text @map("team_id")

  name        String  @db.Text @map("name")
  alias       String? @db.Text @map("alias")
  market      String? @db.Text @map("market")

  baseTeamRaw Json? @db.JsonB @map("base_team_raw")

  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournaments TournamentTeam[]
  homeGames   Game[] @relation("HomeTeam")
  awayGames   Game[] @relation("AwayTeam")
  winsGames   Game[] @relation("WinnerTeam")

  teamStats   TeamTournamentStats[]

  /// UPDATED: GlobalPick no longer points to Team directly (it points to BracketSlot).
  /// globalPicks GlobalPick[]   <-- removed

  draftPicks  DraftPick[]

  /// NEW: slot occupant relation (resolved team for a slot)
  bracketSlotsAssigned BracketSlot[] @relation("BracketSlotAssignedTeam")

  /// NEW: candidate teams for play-in slots
  bracketSlotCandidates BracketSlotCandidate[]

  @@map("teams")
  @@index([alias], map: "ix_teams_alias")
  @@index([name], map: "ix_teams_name")
}

model TournamentTeam {
  tournamentId String @db.Text @map("tournament_id")
  teamId       String @db.Text @map("team_id")

  seed         Int?    @db.SmallInt @map("seed")
  region       String? @db.Text @map("region")
  quadrant     Int?    @db.SmallInt @map("quadrant")

  payloadRaw   Json?   @db.JsonB @map("payload_raw")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([tournamentId, teamId])
  @@map("tournament_teams")
  @@index([tournamentId, seed], map: "ix_tournament_teams_seed")
  @@index([tournamentId, quadrant], map: "ix_tournament_teams_quadrant")
  @@index([teamId], map: "ix_tournament_teams_team")
}

/// NEW: Canonical pick slots (64) per tournament.
/// Users pick these slots; the slot resolves to a Team (assignedTeamId) when known.
model BracketSlot {
  id           String @id @default(uuid()) @db.Uuid @map("bracket_slot_id")

  tournamentId String @db.Text @map("tournament_id")
  quadrant     Int    @db.SmallInt @map("quadrant")
  seed         Int    @db.SmallInt @map("seed")

  /// Resolved occupant team for this slot (null for unresolved play-in slot)
  assignedTeamId String? @db.Text @map("assigned_team_id")

  /// The play-in game that decides this slot (optional)
  playInGameId   String? @unique @db.Text @map("play_in_game_id")

  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  assignedTeam Team? @relation("BracketSlotAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)

  playInGame     Game? @relation("PlayInDecider", fields: [playInGameId], references: [id], onDelete: SetNull)

  candidates   BracketSlotCandidate[]
  globalPicks  GlobalPick[]

  @@map("bracket_slots")
  @@unique([tournamentId, quadrant, seed], map: "ux_bracket_slots_tournament_quadrant_seed")
  @@index([tournamentId], map: "ix_bracket_slots_tournament")
  @@index([assignedTeamId], map: "ix_bracket_slots_assigned_team")
  @@index([playInGameId], map: "ix_bracket_slots_playin_game")
}

/// NEW: Candidate teams for play-in slots (usually 2 candidates per play-in slot)
model BracketSlotCandidate {
  id      String @id @default(uuid()) @db.Uuid @map("bracket_slot_candidate_id")

  slotId  String @db.Uuid @map("bracket_slot_id")
  teamId  String @db.Text @map("team_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  slot    BracketSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  team    Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("bracket_slot_candidates")
  @@unique([slotId, teamId], map: "ux_bracket_slot_candidates_slot_team")
  @@index([slotId], map: "ix_bracket_slot_candidates_slot")
  @@index([teamId], map: "ix_bracket_slot_candidates_team")
}

model Game {
  id           String   @id @db.Text @map("game_id")
  tournamentId String   @db.Text @map("tournament_id")

  round        String?  @db.Text @map("round")
  roundSeq     Int?     @db.SmallInt @map("round_seq")

  scheduledAt  DateTime? @db.Timestamptz(6) @map("scheduled_at")
  status       String   @db.Text @map("status")

  /// Critical to exclude "First Four" from wins counting.
  isPlayIn     Boolean  @default(false) @map("is_play_in")

  homeTeamId   String?  @db.Text @map("home_team_id")
  awayTeamId   String?  @db.Text @map("away_team_id")
  winnerTeamId String?  @db.Text @map("winner_team_id")

  homePoints   Int?     @map("home_points")
  awayPoints   Int?     @map("away_points")

  /// When we first observed a final-like state (complete/closed/forfeited).
  finalizedAt  DateTime? @db.Timestamptz(6) @map("finalized_at")

  /// When we observed status == "closed" (official final in SR often).
  closedAt     DateTime? @db.Timestamptz(6) @map("closed_at")

  payloadRaw   Json?    @db.JsonB @map("payload_raw")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  homeTeam     Team? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team? @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winnerTeam   Team? @relation("WinnerTeam", fields: [winnerTeamId], references: [id])

  /// NEW: optional backrelation (one play-in game can decide at most one slot logically)
  playInSlot   BracketSlot? @relation("PlayInDecider")

  @@map("games")
  @@index([tournamentId, status], map: "ix_games_tournament_status")
  @@index([tournamentId, finalizedAt], map: "ix_games_tournament_finalized")
  @@index([winnerTeamId], map: "ix_games_winner_team")
  @@index([tournamentId, roundSeq], map: "ix_games_tournament_roundseq")
  @@index([tournamentId, scheduledAt], map: "ix_games_tournament_scheduled")
  @@index([tournamentId, isPlayIn], map: "ix_games_tournament_playin")
}

model TeamTournamentStats {
  tournamentId String @db.Text @map("tournament_id")
  teamId       String @db.Text @map("team_id")

  wins         Int @default(0) @map("wins")
  teamScore    Int? @map("team_score")

  lastRecalcAt DateTime? @db.Timestamptz(6) @map("last_recalc_at")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([tournamentId, teamId])
  @@map("team_tournament_stats")
  @@index([tournamentId, wins], map: "ix_team_tournament_stats_wins")
}

model User {
  id            String   @id @default(cuid()) @db.Text @map("user_id")
  name          String?  @db.Text @map("name")
  email         String?  @unique @db.Text @map("email")
  emailVerified DateTime? @db.Timestamptz(6) @map("email_verified")
  image         String?  @db.Text @map("image")

  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  accounts      Account[]
  sessions      Session[]

  globalEntries        GlobalEntry[]
  draftParticipants    DraftParticipant[]
  draftPicks           DraftPick[]
  draftScores          DraftScore[]
  draftInvitesReceived DraftInvite[] @relation("DraftInviteInvitedUser")

  @@map("users")
  @@index([email], map: "ix_users_email")
}

model Account {
  id                String  @id @default(cuid()) @map("account_id")
  userId            String  @db.Text @map("user_id")
  type              String  @db.Text @map("type")
  provider          String  @db.Text @map("provider")
  providerAccountId String  @db.Text @map("provider_account_id")

  refresh_token     String? @db.Text @map("refresh_token")
  access_token      String? @db.Text @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @db.Text @map("token_type")
  scope             String? @db.Text @map("scope")
  id_token          String? @db.Text @map("id_token")
  session_state     String? @db.Text @map("session_state")

  createdAt         DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
  @@unique([provider, providerAccountId], map: "ux_accounts_provider_provideraccount")
  @@index([userId], map: "ix_accounts_user")
}

model Session {
  id           String   @id @default(cuid()) @map("session_id")
  sessionToken String   @unique @db.Text @map("session_token")
  userId       String   @db.Text @map("user_id")
  expires      DateTime @db.Timestamptz(6) @map("expires")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId], map: "ix_sessions_user")
}

model VerificationToken {
  identifier String   @db.Text @map("identifier")
  token      String   @unique @db.Text @map("token")
  expires    DateTime @db.Timestamptz(6) @map("expires")

  @@map("verification_tokens")
  @@unique([identifier, token], map: "ux_verification_tokens_identifier_token")
}

model GlobalContest {
  id           String @id @default(uuid()) @db.Uuid @map("global_contest_id")
  tournamentId String @db.Text @map("tournament_id")

  name         String @db.Text @default("Global") @map("name")
  status       GlobalContestStatus @default(OPEN) @map("status")
  lockAt       DateTime? @db.Timestamptz(6) @map("lock_at")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entries      GlobalEntry[]

  @@map("global_contests")
  @@unique([tournamentId], map: "ux_global_contests_tournament")
  @@index([status, lockAt], map: "ix_global_contests_status_lockat")
}

model GlobalEntry {
  id        String @id @default(uuid()) @db.Uuid @map("global_entry_id")
  contestId String @db.Uuid @map("global_contest_id")
  userId    String @db.Text @map("user_id")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  contest   GlobalContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks     GlobalPick[]
  score     GlobalScore?

  @@map("global_entries")
  @@unique([contestId, userId], map: "ux_global_entries_contest_user")
  @@index([userId], map: "ix_global_entries_user")
}

/// UPDATED: picks are now BracketSlot-based, not Team-based.
model GlobalPick {
  entryId   String @db.Uuid @map("global_entry_id")
  slotId    String @db.Uuid @map("bracket_slot_id")
  pickNo    Int    @db.SmallInt @map("pick_no")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  entry     GlobalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  slot      BracketSlot  @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@map("global_picks")
  @@id([entryId, pickNo])
  @@unique([entryId, slotId], map: "ux_global_picks_entry_slot")
  @@index([slotId], map: "ix_global_picks_slot")
}

model GlobalScore {
  entryId     String @id @db.Uuid @map("global_entry_id")
  score       Int    @default(0) @map("score")
  breakdown   Json?  @db.JsonB @map("breakdown")
  lastRecalcAt DateTime? @db.Timestamptz(6) @map("last_recalc_at")

  entry       GlobalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("global_scores")
  @@index([score], map: "ix_global_scores_score")
}

/* ---- everything below this line is unchanged from your original schema ---- */

model Draft {
  id           String @id @default(uuid()) @db.Uuid @map("draft_id")
  tournamentId String @db.Text @map("tournament_id")

  name         String @db.Text @map("name")
  status       DraftStatus @default(OPEN) @map("status")
  draftType    DraftType @default(SNAKE) @map("draft_type")

  rosterSize   Int @default(8) @map("roster_size")
  isPrivate    Boolean @default(true) @map("is_private")

  inviteCode   String? @db.Text @unique(map: "ux_drafts_invite_code") @map("invite_code")
  pickTimerSec Int? @map("pick_timer_sec")

  lockAt       DateTime? @db.Timestamptz(6) @map("lock_at")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  participants DraftParticipant[]
  picks        DraftPick[]
  scores       DraftScore[]
  invites      DraftInvite[]

  @@map("drafts")
  @@index([tournamentId, status], map: "ix_drafts_tournament_status")
}

model DraftParticipant {
  draftId   String @db.Uuid @map("draft_id")
  userId    String @db.Text @map("user_id")

  pickOrder Int    @db.SmallInt @map("pick_order")
  isHost    Boolean @default(false) @map("is_host")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_participants")
  @@id([draftId, userId])
  @@index([draftId, pickOrder], map: "ix_draft_participants_order")
}

model DraftPick {
  id            String @id @default(uuid()) @db.Uuid @map("draft_pick_id")
  draftId       String @db.Uuid @map("draft_id")
  userId        String @db.Text @map("user_id")
  teamId        String @db.Text @map("team_id")

  overallPickNo Int  @map("overall_pick_no")
  rosterSlot    Int? @db.SmallInt @map("roster_slot")

  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@map("draft_picks")
  @@unique([draftId, teamId], map: "ux_draft_picks_draft_team")
  @@unique([draftId, overallPickNo], map: "ux_draft_picks_draft_overallpick")
  @@unique([draftId, userId, rosterSlot], map: "ux_draft_picks_user_rosterslot")
  @@index([draftId, userId], map: "ix_draft_picks_draft_user")
  @@index([teamId], map: "ix_draft_picks_team")
}

model DraftScore {
  draftId      String @db.Uuid @map("draft_id")
  userId       String @db.Text @map("user_id")

  score        Int    @default(0) @map("score")
  breakdown    Json?  @db.JsonB @map("breakdown")
  lastRecalcAt DateTime? @db.Timestamptz(6) @map("last_recalc_at")

  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("draft_scores")
  @@id([draftId, userId])
  @@index([draftId, score], map: "ix_draft_scores_leaderboard")
}

model DraftInvite {
  id            String @id @default(uuid()) @db.Uuid @map("draft_invite_id")
  draftId       String @db.Uuid @map("draft_id")

  email         String? @db.Text @map("email")
  invitedUserId String? @db.Text @map("invited_user_id")

  status        InviteStatus @default(PENDING) @map("status")

  token         String @unique(map: "ux_draft_invites_token") @map("token")
  expiresAt     DateTime? @db.Timestamptz(6) @map("expires_at")

  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  draft         Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  invitedUser   User? @relation("DraftInviteInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@map("draft_invites")
  @@index([draftId, status], map: "ix_draft_invites_status")
  @@index([email], map: "ix_draft_invites_email")
}

model SyncLog {
  id           String @id @default(uuid()) @db.Uuid @map("sync_log_id")

  feedType     SyncFeedType @map("feed_type")
  tournamentId String? @db.Text @map("tournament_id")
  entityId     String? @db.Text @map("entity_id")

  fetchedAt    DateTime @default(now()) @db.Timestamptz(6) @map("fetched_at")

  httpStatus   Int @map("http_status")
  error        String? @db.Text @map("error")

  payload      Json? @db.JsonB @map("payload")
  payloadHash  String? @db.Text @map("payload_hash")

  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@map("sync_logs")
  @@index([feedType, fetchedAt], map: "ix_sync_logs_feed_fetched")
  @@index([tournamentId, feedType, fetchedAt], map: "ix_sync_logs_tournament_feed_fetched")
  @@index([entityId, feedType, fetchedAt], map: "ix_sync_logs_entity_feed_fetched")
}

model SchedulerLease {
  id        String   @id @default("singleton")
  lockedBy  String?
  lockedAt  DateTime?
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}
