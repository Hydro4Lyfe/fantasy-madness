# ===========================================
# Fantasy Madness - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---- Domain & SSL ----
DOMAIN=yourdomain.com
ACME_EMAIL=your-email@example.com

# ---- Supabase Database ----
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- SportRadar API ----
SPORTRADAR_BASE_URL=https://api.sportradar.com/ncaamb/trial/v8/en
SPORTRADAR_API_KEY=your-api-key-here

# ---- Optional ----
LOG_LEVEL=info
